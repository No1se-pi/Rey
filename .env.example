# Existing Rey core
APP_NAME=rei
APP_ENV=dev
LOG_LEVEL=INFO
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_TIMEOUT_SECONDS=90
DATABASE_URL=sqlite:///data/rei_memory.sqlite3

STT_MODEL_SIZE=small
STT_DEVICE=auto
STT_COMPUTE_TYPE=auto

TTS_ENGINE=pyttsx3
TTS_VOICE_NAME=
TTS_RATE=175
TTS_VOLUME=0.9

VOICE_ENABLED=false

MEMORY_ENABLED=true
MAX_HISTORY_MESSAGES=20
CHILD_SAFE_MODE=auto

# Rey 2.0.1 Telegram (never commit real credentials)
REY_TG_API_ID=
REY_TG_API_HASH=
REY_TG_BOT_TOKEN=
REY_TG_ALLOWED_IDS=
REY_TG_ALLOWED_CHAT_IDS=
REY_TG_SESSION_PATH=data/rey_bot
REY_TG_SEND_TEXT=true
REY_TG_SEND_MP3=false
REY_TG_MAX_PENDING_REQUESTS=3

# Qwen3-TTS: design or clone
REY_TTS_MODE=design
REY_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-VoiceDesign
REY_TTS_DEVICE=auto
REY_TTS_INSTRUCTION=A natural young adult Russian female voice, calm, warm and expressive, with clear articulation. Avoid robotic delivery.
REY_TTS_REFERENCE_AUDIO=
REY_TTS_REFERENCE_TEXT=
REY_TTS_UNLOAD_AFTER_SYNTHESIS=true
REY_TTS_CPU_FALLBACK=false
REY_TTS_ALLOW_MODEL_DOWNLOAD=false
REY_TTS_CHUNK_CHARS=320
REY_OLLAMA_UNLOAD_BEFORE_TTS=true

# Speech input/output
REY_MODEL_CACHE_DIR=data/model_cache
REY_STT_MODEL=small
REY_STT_DEVICE=cpu
REY_STT_CPU_FALLBACK=true
REY_STT_UNLOAD_AFTER_TRANSCRIPTION=true
REY_VOICE_OUTPUT_DIR=data/voice_output
REY_KEEP_OUTPUT_AUDIO=true
REY_CLI_VOICE_ENABLED=true
REY_MAX_AUDIO_SECONDS=180
REY_MAX_AUDIO_BYTES=15728640
REY_MAX_REPLY_CHARS=1500
REY_FFMPEG_TIMEOUT_SECONDS=120
